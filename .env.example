# MusMemo — sao chép thành .env để chạy local.
# Trên GitHub Actions, mỗi biến ở đây là một entry trong Settings → Secrets.

# --- YouTube ---
YOUTUBE_API_KEY=
MUSMEMO_PLAYLIST_ID=

# --- LLM gắn tag cho video (§3 Ingest) ---
ANTHROPIC_API_KEY=
# Mặc định claude-opus-5. Đổi sang claude-haiku-4-5 nếu muốn rẻ hơn —
# gắn tag video là việc phân loại đơn giản.
ANTHROPIC_MODEL=

# --- Google Calendar + Gmail ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Hồ sơ người dùng (§11 — cần bạn chốt) ---
MUSMEMO_TZ=Asia/Ho_Chi_Minh
MUSMEMO_GIO_TAP=06:00          # §11 câu 03
MUSMEMO_TRAN_TA_KG=30          # §11 câu 01 — mỗi tay hay cả bộ?
MUSMEMO_EMAIL=
# Link Google Form để ghi mức tạ sau buổi tập. Bỏ trống thì event
# sẽ bảo bạn trả lời email tổng kết chủ nhật thay thế.
MUSMEMO_FORM_URL=
